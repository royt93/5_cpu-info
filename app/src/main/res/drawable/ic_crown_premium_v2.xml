<?xml version="1.0" encoding="utf-8"?>
<!-- Crown đơn giản, sạch — 3 peaks + base bar.
     Tránh đặt gem dots inline vì ImageView `app:tint` apply 1 color cho toàn drawable
     → gems sẽ bị tinted thành cùng màu crown body, trông như "dấu chấm" lạ. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Crown body — 3 peaks zigzag, joined với base bar thành 1 path liên tục để render mượt -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5,16L3,5l5.5,5L12,4l3.5,6L21,5l-2,11H5z" />

    <!-- Base bar -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5.83,18h12.34c0.5,0,0.91,0.41,0.91,0.91v0.18c0,0.5-0.41,0.91-0.91,0.91H5.83C5.33,20,4.92,19.59,4.92,19.09v-0.18C4.92,18.41,5.33,18,5.83,18z" />
</vector>
