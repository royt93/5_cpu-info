<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetShieldScoreRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ram_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shield" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/shield_score_widget_label"
            android:textColor="@color/onSurface"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetShieldScorePercent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="24sp"
        android:textStyle="bold"
        tools:text="82"
        tools:textColor="#4CAF50" />

    <ProgressBar
        android:id="@+id/widgetShieldScoreProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressTint="@color/accent"
        tools:progress="82" />

    <TextView
        android:id="@+id/widgetShieldScoreRamRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/onSurface"
        android:textSize="12sp"
        tools:text="RAM: 74" />

    <TextView
        android:id="@+id/widgetShieldScoreStorageRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/onSurface"
        android:textSize="12sp"
        tools:text="Storage: 61" />

    <TextView
        android:id="@+id/widgetShieldScoreBatteryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/onSurface"
        android:textSize="12sp"
        tools:text="Battery: 90" />

</LinearLayout>
