<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- F09/U06 — cluster topology summary (Prime/Performance/Efficiency) is item 0 of this
             RecyclerView's ConcatAdapter (see FrmCpuInfo.kt), not a sticky sibling view, so it
             scrolls away with the per-core list below instead of pinning to the top. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="72dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <!-- U01 entry point — device authenticity check, contextually belongs on the CPU tab
             rather than the shared toolbar (which already has Shield/VIP/Share). Extended FAB,
             same shrink-on-scroll style as the Sensors tab's FAB (see FabScrollBehavior.kt):
             shows its label at rest, shrinks to an icon-only pill while the list scrolls so it
             never permanently dominates the screen or covers content. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabDeviceTruth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/device_truth_fab_label"
            android:textAllCaps="false"
            app:icon="@drawable/ic_device_truth" />

    </FrameLayout>

</layout>
