<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- F08 — Vulkan/GLES detail summary bar is item 0 of this RecyclerView's ConcatAdapter
             (see FrmGpuInfo.kt), not a sticky sibling view, so it scrolls away with the
             vendor/renderer/extensions rows below instead of pinning to the top. Hidden until
             GLSurfaceView's onSurfaceCreated() delivers GL_EXTENSIONS. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </FrameLayout>

</layout>
