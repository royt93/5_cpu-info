<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vipFragmentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/vipRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ===== Hero card: status + crown + dates + progress + countdown ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/statusHeaderInner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_vip_status_header_free"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp">

                    <!-- Crown với glow halo -->
                    <FrameLayout
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:clipChildren="false">

                        <View
                            android:id="@+id/viewCrownGlow"
                            android:layout_width="116dp"
                            android:layout_height="116dp"
                            android:layout_gravity="center"
                            android:alpha="0.6"
                            android:background="@drawable/bg_crown_glow"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <ImageView
                            android:id="@+id/imgCrown"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/vip_active"
                            android:src="@drawable/ic_workspace_premium"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.02"
                        android:text="@string/vip_free_user"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="VIP đang kích hoạt" />

                    <TextView
                        android:id="@+id/tvStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:alpha="0.95"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        tools:text="Until 31/12/2026 23:59" />

                    <TextView
                        android:id="@+id/tvActivatedAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:alpha="0.85"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Activated: 01/01/2026 09:00"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvExpiresAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.85"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Expires: 31/01/2026 09:00"
                        tools:visibility="visible" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressVip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:indicatorColor="@android:color/white"
                        app:trackColor="#33FFFFFF"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="10dp"
                        tools:progress="33"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFeatureSettings="tnum"
                        android:letterSpacing="0.04"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="20d 03h 24m 15s"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Stats card: days remaining + total activated ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/progressBackground"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/vip_stats_title"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatsDaysRemaining"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="27" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.65"
                                android:text="@string/vip_stats_days_remaining"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginVertical="4dp"
                            android:alpha="0.4"
                            android:background="@color/progressBackground" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatsTotalActivated"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/vip_gold_dark"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="63" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.65"
                                android:text="@string/vip_stats_total_activated"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Active VIP card single-entry ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/progressBackground"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="🎟"
                        android:textSize="32sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvActiveEntryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="🎁 First-install gift" />

                        <TextView
                            android:id="@+id/tvActiveEntryExpiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7"
                            android:textSize="13sp"
                            tools:text="Expires: 31/01/2026 09:00" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Redeem section card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRedeem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/progressBackground"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRedeemKey"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/vip_redeem_label"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:endIconMode="clear_text"
                        app:startIconDrawable="@drawable/ic_confirmation_number">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRedeemKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textVisiblePassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRedeemKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="@string/vip_redeem_button"
                        android:textSize="15sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Rewarded ad — wrap pulse btn trong container clipChildren=false ===== -->
            <FrameLayout
                android:id="@+id/watchAdContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchAd"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="@string/vip_watch_ad_3d"
                    android:textSize="15sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_play_circle"
                    app:iconGravity="textStart"
                    app:iconSize="22dp" />
            </FrameLayout>

            <!-- ===== Buy buttons (4 + restore) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/progressBackground"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy30d"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:minHeight="44dp"
                        android:text="@string/vip_buy_30d_locked"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy90d"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:minHeight="44dp"
                        android:text="@string/vip_buy_90d_locked"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuy1y"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:minHeight="44dp"
                        android:text="@string/vip_buy_1y_locked"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuyLifetime"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:enabled="false"
                        android:minHeight="44dp"
                        android:text="@string/vip_buy_lifetime_locked"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_card_giftcard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRestorePurchase"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:enabled="false"
                        android:minHeight="44dp"
                        android:text="@string/vip_restore_locked"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_restore" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Revoke + Privacy footer ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRevoke"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vip_revoke_all_button"
                android:textColor="@color/error" />

            <TextView
                android:id="@+id/tvPrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:text="@string/vip_privacy_policy"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Lottie confetti — full-screen overlay, KHÔNG ảnh hưởng layout của ScrollView content.
         clickable=false để pass-through touch xuống content. -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieConfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/anim_confetti" />

</FrameLayout>
