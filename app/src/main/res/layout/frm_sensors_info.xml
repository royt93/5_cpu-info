<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- F12 — the waveform row (item_sensor_waveform_header.xml) is item 0 of this
             RecyclerView's ConcatAdapter (see AdtSensorWaveformHeader.kt / FrmSensorsInfo.kt),
             not a sticky sibling view, so it scrolls away with the sensor value rows below. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical" />

        <!-- F07 entry point — guided pass/fail sensor test, contextually belongs on the Sensors
             tab rather than the shared toolbar. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabSensorTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/sensor_test_fab_label"
            android:textAllCaps="false"
            app:icon="@drawable/ic_play_circle" />

    </FrameLayout>

</layout>
