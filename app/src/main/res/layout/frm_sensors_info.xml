<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- F12 — live waveform (last 50 samples) for the 3 sensor types worth charting.
                 Each group's visibility is toggled in FrmSensorsInfo.kt based on whether the
                 device actually has that sensor — never shows a permanently-empty chart. -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/waveformRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingTop="8dp">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/waveformAccelerometerGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/TextAnnotation1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_waveform_accelerometer" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartAccelerometer"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="4dp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/waveformGyroscopeGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/TextAnnotation1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_waveform_gyroscope" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartGyroscope"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="4dp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/waveformBarometerGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/TextAnnotation1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sensor_waveform_barometer" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartBarometer"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="4dp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- F07 entry point — guided pass/fail sensor test, contextually belongs on the Sensors
             tab rather than the shared toolbar. -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabSensorTest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/sensor_test_fab_label"
            android:textAllCaps="false"
            app:icon="@drawable/ic_play_circle" />

    </FrameLayout>

</layout>
